{
  "schemaVersion": "2.0.0",
  "name": "ai-harness",
  "version": "14.3.0",
  "sourceVersion": "14.2.0",
  "lifecycleModeDefault": "full",
  "bootstrap": {
    "projectStateTemplate": "harness/templates/project.bootstrap.json",
    "initialProjectState": "MIGRATION_PENDING"
  },
  "categories": {
    "core": [
      "harness/lifecycle",
      "harness/invariants",
      "harness/execution",
      "harness/authorization",
      "harness/fallback",
      "harness/policies",
      "harness/cursor",
      "harness/skills",
      "harness/schemas",
      "harness/schema-fixtures",
      "harness/contracts",
      "harness/capabilities",
      "harness/integrations",
      "harness/profiles",
      "harness/prompts",
      "harness/rules",
      "harness/templates",
      "scripts/harness",
      "scripts/github",
      "scripts/mcp",
      "docs/workflow",
      "docs/operations",
      "docs/architecture",
      "docs/specs/TEMPLATE",
      "docs/improvements/TEMPLATE.md",
      "docs/worklog",
      ".githooks",
      ".codex",
      ".cursor/mcp.json",
      ".github/pull_request_template.md",
      ".github/workflows/quality.yml",
      ".github/workflows/release-gate.yml",
      "SECURITY.md",
      "MIGRATION.md",
      "CHANGELOG.md",
      "README_HARNESS.md",
      "NEW_REPOSITORY_SETUP.md",
      "package.scripts.fragment.json",
      "package.devDependencies.fragment.json",
      ".gitignore.harness-fragment"
    ],
    "optionalProfiles": {
      "framework/react": [
        "components/",
        "src/components/",
        "styles/",
        "src/styles/",
        "content/",
        "src/content/"
      ],
      "framework/nextjs-app-router": [
        "app/",
        "src/"
      ],
      "test/vitest-rtl": [
        "tests/",
        "src/__tests__/"
      ],
      "test/playwright": [
        "e2e/",
        ".github/workflows/e2e.yml"
      ],
      "quality/react-doctor": [
        "doctor.config.json",
        ".github/workflows/react-doctor.yml"
      ],
      "language/typescript": [
        "lib/",
        "src/lib/"
      ]
    },
    "generated": [
      "AGENTS.md",
      "**/CODEX.md",
      "**/.cursor/rules/*.mdc",
      ".cursor/cli.json",
      ".cursor/hooks.json",
      ".codex/rules/guardrails.rules",
      "docs/workflow/LIFECYCLE_REFERENCE.generated.md",
      "harness/generated/profile-resolution.json"
    ]
  },
  "verification": {
    "harnessGenerate": "npm run harness:generate",
    "harnessCheck": "npm run harness:check",
    "schemaValidation": "npm run schemas:check",
    "profileResolve": "npm run profile:resolve (after proposedProfiles set)",
    "note": "Bundled profile-resolution.json ships unresolved until profiles are chosen and resolved."
  },
  "knownConstraints": [
    "Bundled web/React/Next scaffold and workflows are optional; remove unused paths if not selected.",
    "Stack-specific rules generate only when matching profiles are active or proposed.",
    "Local human approval records require protected branches and external environment controls.",
    "Production release workflow verifies approval but does not deploy by itself.",
    "New-repository bootstrap creates only the harness npm substrate and does not approve a product stack or lifecycle transition.",
    "Codex project trust is user-scoped and is never auto-written; codex:preflight must pass before delegated ai:* commands.",
    "GitHub context requires an intended HTTPS origin and reports bounded unavailability reason codes without stderr or tokens.",
    "Cursor CLI is optional; live provider authentication and permission behavior must be verified on a workstation with the CLI installed.",
    "Cursor Hooks are defense in depth; project permissions and Git-common-dir worktree isolation remain the primary boundary.",
    "Directory-scoped generated AGENTS.md files are retired; Codex specialization uses CODEX.md while Cursor uses scoped .mdc rules."
  ],
  "executionSafety": {
    "schemaVersion": "1.0.0",
    "lifecycleOwner": "harness/lifecycle/manifest.json",
    "invariants": "harness/invariants/manifest.json",
    "execution": "harness/execution/manifest.json",
    "authorization": "harness/authorization/manifest.json",
    "runStore": ".harness/runs"
  },
  "executorFallback": {
    "manifest": "harness/fallback/manifest.json",
    "cursorSkill": ".cursor/skills/executor-fallback/SKILL.md",
    "defaultOrder": [
      "cursor",
      "codex-cli",
      "human"
    ],
    "cursorTransports": [
      "cursor-ide",
      "cursor-cli"
    ]
  },
  "instructionProjection": {
    "manifest": "harness/rules/manifest.json",
    "sharedGlobal": "AGENTS.md",
    "codexDirectoryFallback": "CODEX.md",
    "cursorScopedRules": ".cursor/rules/*.mdc",
    "sameConsumerDuplicationCheck": "scripts/harness/check-instruction-graph.mjs"
  },
  "commandPolicy": {
    "manifest": "harness/policies/command-guardrails.json",
    "projectionCheck": "scripts/harness/check-policy-projections.mjs"
  },
  "cursorCli": {
    "manifest": "harness/cursor/manifest.json",
    "optional": true,
    "logicalExecutor": "cursor",
    "transport": "cursor-cli",
    "primarySafetyBoundary": "project permissions plus harness-managed Git-common-dir worktree isolation",
    "autoApply": false,
    "acpEnabledByDefault": false
  }
}
