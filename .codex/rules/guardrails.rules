prefix_rule(
    pattern = ["git","reset","--hard"],
    decision = "forbidden",
    justification = "履歴と未コミット変更を破壊します。安全な差分確認と限定的な restore を使用してください。",
    match = ["git reset --hard","git reset --hard HEAD~1"],
)

