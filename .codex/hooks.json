{
  "description": "Repository-local safety hooks for Codex CLI.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "commandWindows": "py -3 \"%CD%\\.codex\\hooks\\pre_tool_use_policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking repository safety policy"
          }
        ]
      }
    ]
  }
}
