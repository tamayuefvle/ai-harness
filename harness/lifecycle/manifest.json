{
  "schemaVersion": "2.0.0",
  "projectGates": {
    "planning": {
      "phase": "PLANNING",
      "requiredDocuments": [
        "docs/product/problem.md",
        "docs/product/users.md",
        "docs/product/outcomes.md",
        "docs/product/requirements.md"
      ],
      "checker": "product"
    },
    "stack": {
      "phase": "DESIGNING",
      "requiredDocuments": [
        "docs/architecture/technology-options.md",
        "docs/architecture/technology-decision.md"
      ],
      "checker": "stack"
    },
    "architecture": {
      "phase": "DESIGNING",
      "requiredDocuments": [
        "docs/architecture/baseline.md",
        "docs/architecture/security-baseline.md",
        "docs/architecture/quality-strategy.md"
      ],
      "checker": "architecture"
    },
    "design": {
      "phase": "DESIGNING",
      "requiredDocuments": [
        "docs/architecture/technology-options.md",
        "docs/architecture/technology-decision.md",
        "docs/architecture/baseline.md",
        "docs/architecture/security-baseline.md",
        "docs/architecture/quality-strategy.md",
        "harness/generated/profile-resolution.json"
      ],
      "checker": "design"
    }
  },
  "lifecycles": {
    "project": {
      "initialState": "PLANNING",
      "activeStates": [
        "MIGRATION_PENDING",
        "PLANNING",
        "DESIGNING",
        "ACTIVE"
      ],
      "terminalStates": [
        "RETIRED"
      ],
      "transitions": [
        {
          "from": "MIGRATION_PENDING",
          "to": "PLANNING",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "MIGRATION_PENDING",
          "to": "ACTIVE",
          "approval": "human",
          "requiredDocuments": [
            "docs/product/vision.md",
            "docs/product/scope.md",
            "docs/architecture/technology-decision.md",
            "docs/architecture/ADR-0001-stack.md",
            "docs/architecture/baseline.md"
          ]
        },
        {
          "from": "PLANNING",
          "to": "DESIGNING",
          "approval": "gate:planning",
          "requiredDocuments": [
            "docs/product/problem.md",
            "docs/product/users.md",
            "docs/product/outcomes.md",
            "docs/product/requirements.md"
          ]
        },
        {
          "from": "DESIGNING",
          "to": "PLANNING",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "DESIGNING",
          "to": "ACTIVE",
          "approval": "gate:design",
          "requiredDocuments": [
            "docs/architecture/technology-options.md",
            "docs/architecture/technology-decision.md",
            "docs/architecture/baseline.md",
            "docs/architecture/security-baseline.md",
            "docs/architecture/quality-strategy.md",
            "harness/generated/profile-resolution.json"
          ]
        },
        {
          "from": "ACTIVE",
          "to": "RETIRED",
          "approval": "human",
          "requiredDocuments": [
            "docs/operations/retirement-plan.md"
          ]
        }
      ]
    },
    "task": {
      "initialState": "DESIGNING",
      "activeStates": [
        "DESIGNING",
        "DEVELOPING",
        "VERIFYING",
        "REVIEWING",
        "DEPLOY_READY"
      ],
      "terminalStates": [
        "DONE"
      ],
      "transitions": [
        {
          "from": "DESIGNING",
          "to": "DEVELOPING",
          "approval": "gate:design",
          "requiredDocuments": [
            "docs/specs/{{TASK_ID}}/brief.md",
            "docs/specs/{{TASK_ID}}/acceptance.md",
            "docs/specs/{{TASK_ID}}/design.md",
            "docs/specs/{{TASK_ID}}/test-plan.md"
          ]
        },
        {
          "from": "DEVELOPING",
          "to": "VERIFYING",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "VERIFYING",
          "to": "REVIEWING",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "REVIEWING",
          "to": "DEPLOY_READY",
          "approval": "gate:release",
          "requiredDocuments": []
        },
        {
          "from": "DEPLOY_READY",
          "to": "DONE",
          "approval": "none",
          "requiredDocuments": []
        }
      ]
    },
    "release": {
      "initialState": "CANDIDATE",
      "activeStates": [
        "CANDIDATE",
        "PREVIEW_VERIFIED",
        "PRODUCTION_APPROVED",
        "DEPLOYED",
        "OBSERVING"
      ],
      "terminalStates": [
        "ACCEPTED",
        "ROLLED_BACK",
        "CANCELLED"
      ],
      "transitions": [
        {
          "from": "CANDIDATE",
          "to": "PREVIEW_VERIFIED",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "PREVIEW_VERIFIED",
          "to": "PRODUCTION_APPROVED",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "PRODUCTION_APPROVED",
          "to": "DEPLOYED",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "DEPLOYED",
          "to": "OBSERVING",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "OBSERVING",
          "to": "ACCEPTED",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "DEPLOYED",
          "to": "ROLLED_BACK",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "CANDIDATE",
          "to": "CANCELLED",
          "approval": "human",
          "requiredDocuments": []
        }
      ]
    },
    "incident": {
      "initialState": "DETECTED",
      "activeStates": [
        "DETECTED",
        "TRIAGED",
        "MITIGATION_APPROVED",
        "RECOVERED",
        "POSTMORTEM_READY"
      ],
      "terminalStates": [
        "CLOSED"
      ],
      "transitions": [
        {
          "from": "DETECTED",
          "to": "TRIAGED",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "TRIAGED",
          "to": "MITIGATION_APPROVED",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "MITIGATION_APPROVED",
          "to": "RECOVERED",
          "approval": "human",
          "requiredDocuments": []
        },
        {
          "from": "RECOVERED",
          "to": "POSTMORTEM_READY",
          "approval": "none",
          "requiredDocuments": []
        },
        {
          "from": "POSTMORTEM_READY",
          "to": "CLOSED",
          "approval": "human",
          "requiredDocuments": []
        }
      ]
    }
  }
}
