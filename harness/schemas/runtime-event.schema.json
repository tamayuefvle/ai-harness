{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/runtime-event.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "sequence",
    "type",
    "timestamp",
    "actorRole",
    "operationId",
    "operationRef",
    "artifactRef",
    "digest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^EVT-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "run-started",
        "run-paused",
        "approval-recorded",
        "run-resumed",
        "operation-authorized",
        "operation-completed",
        "run-finished",
        "recovery-started",
        "recovery-reconciled"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actorRole": {
      "type": "string",
      "minLength": 1
    },
    "operationRef": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "capabilityId",
            "providerId",
            "operation"
          ],
          "properties": {
            "capabilityId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "providerId": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OP-[A-Z0-9-]+$"
    }
  },
  "additionalProperties": false
}
