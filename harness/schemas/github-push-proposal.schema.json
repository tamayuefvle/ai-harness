{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/github-push-proposal.schema.json",
  "type": "object",
  "required": ["schemaVersion", "operation", "repository", "remote", "branch", "baseBranch", "localHead", "files", "evidence", "commands", "requiresHumanApproval"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "operation": { "enum": ["push", "push-and-create-pr"] },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "remote": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+(?:\\.git)?$" },
    "branch": { "type": "string", "not": { "enum": ["main", "master"] } },
    "baseBranch": { "type": "string" },
    "localHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "files": {
      "type": "object",
      "required": ["included", "unexpected"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "unexpected": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["implementation", "verification", "review"],
      "properties": {
        "implementation": {
          "type": "object",
          "required": ["status", "report"],
          "properties": { "status": { "const": "passed" }, "report": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": ["status", "report"],
          "properties": { "status": { "enum": ["pending", "passed"] }, "report": { "type": ["string", "null"] } },
          "allOf": [{ "if": { "type": "object", "properties": { "status": { "const": "passed" } } }, "then": { "type": "object", "properties": { "report": { "type": "string", "minLength": 1 } } } }],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": ["status", "report"],
          "properties": { "status": { "enum": ["pending", "approved"] }, "report": { "type": ["string", "null"] } },
          "allOf": [{ "if": { "type": "object", "properties": { "status": { "const": "approved" } } }, "then": { "type": "object", "properties": { "report": { "type": "string", "minLength": 1 } } } }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "not": { "pattern": "--force|force-with-lease|gh pr merge|gh secret|gh variable" } }
    },
    "requiresHumanApproval": { "const": true }
  },
  "additionalProperties": false
}
