{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/discovery-session.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "projectId",
    "discoveryTier",
    "phase",
    "startedAt",
    "updatedAt",
    "turns",
    "openQuestions",
    "citations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^DISC-[0-9]{8}-[a-z0-9]{6}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "discoveryTier": {
      "enum": [
        "lite",
        "full"
      ]
    },
    "phase": {
      "enum": [
        "problem",
        "users",
        "outcomes",
        "requirements",
        "review"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "role",
          "summary"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "enum": [
              "agent",
              "human"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "targetDocument": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref",
          "summary"
        ],
        "properties": {
          "type": {
            "enum": [
              "session",
              "source",
              "assumption"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "productCheckSnapshot": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "errors"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
