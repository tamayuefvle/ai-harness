{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}(?:-[a-z0-9][a-z0-9-]*)?$",
      "$comment": "task_id.pattern is generated from harness/contracts/task-id.json; run npm run harness:generate"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "file",
          "line",
          "title",
          "evidence",
          "impact",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "unverified_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "report": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "blocked",
              "failed",
              "partial",
              "skipped",
              "complete",
              "degraded",
              "unavailable"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "tool",
          "report",
          "status",
          "sha256",
          "reviewed",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "head_sha",
    "verdict",
    "summary",
    "findings",
    "unverified_areas",
    "test_recommendations",
    "diagnostic_evidence"
  ],
  "additionalProperties": false,
  "$id": "https://portfolio-harness.local/schemas/review.schema.json"
}
