{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/project-state.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "lifecycleMode",
    "state",
    "phaseGates",
    "pendingApproval",
    "decisionRefs",
    "activeProfiles",
    "profileResolutionPath",
    "migration",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "lifecycleMode": {
      "enum": [
        "delivery-only",
        "full"
      ]
    },
    "state": {
      "enum": [
        "MIGRATION_PENDING",
        "PLANNING",
        "DESIGNING",
        "ACTIVE",
        "RETIRED"
      ]
    },
    "phaseGates": {
      "type": "object",
      "required": [
        "planning",
        "stack",
        "architecture",
        "design"
      ],
      "properties": {
        "planning": {
          "$ref": "#/$defs/approvalGate"
        },
        "stack": {
          "$ref": "#/$defs/approvalGate"
        },
        "architecture": {
          "$ref": "#/$defs/approvalGate"
        },
        "design": {
          "$ref": "#/$defs/approvalGate"
        }
      },
      "additionalProperties": false
    },
    "pendingApproval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "targetState": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string",
          "pattern": "^human:.+"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "contractHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "targetState",
        "approvedBy",
        "approvedAt",
        "reason",
        "contractHash"
      ],
      "additionalProperties": false
    },
    "decisionRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
      }
    },
    "proposedProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
      }
    },
    "profileResolutionPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "planningTier": {
      "enum": [
        "lite",
        "full"
      ]
    },
    "discoveryTier": {
      "enum": [
        "lite",
        "full"
      ]
    },
    "designTier": {
      "enum": [
        "lite",
        "full"
      ]
    },
    "activePlanningSession": {
      "type": "string",
      "pattern": "^DISC-[0-9]{8}-[a-z0-9]{6}$"
    },
    "activeDiscoverySession": {
      "type": "string",
      "pattern": "^DISC-[0-9]{8}-[a-z0-9]{6}$"
    },
    "activeDesignSession": {
      "type": "string",
      "pattern": "^DSN-[0-9]{8}-[a-z0-9]{6}$"
    },
    "migration": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fromVersion": {
          "type": "string"
        },
        "fromState": {
          "type": "string"
        },
        "proposedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "fromVersion",
        "proposedProfiles",
        "notes"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "actor",
          "reason",
          "at"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "contractHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "approvalGate": {
      "type": "object",
      "required": [
        "status",
        "approvedBy",
        "approvedAt",
        "reason",
        "contractHash"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "approvedBy": {
                "type": "string",
                "pattern": "^human:.+"
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "contractHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
