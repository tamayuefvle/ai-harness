{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/incident-gate.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "incidentId",
    "state",
    "severity",
    "detectedAt",
    "summary",
    "impact",
    "mitigationApproval",
    "recovery",
    "postmortemPath",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "incidentId": {
      "type": "string",
      "pattern": "^INC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "state": {
      "enum": [
        "DETECTED",
        "TRIAGED",
        "MITIGATION_APPROVED",
        "RECOVERED",
        "POSTMORTEM_READY",
        "CLOSED"
      ]
    },
    "severity": {
      "enum": [
        "SEV1",
        "SEV2",
        "SEV3",
        "SEV4"
      ]
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "mitigationApproval": {
      "type": "object",
      "required": [
        "status",
        "approvedBy",
        "approvedAt",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": [
        "status",
        "evidence",
        "recordedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "recovered",
            "failed"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "postmortemPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "actor",
          "reason",
          "at"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
