{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/improvement-proposal.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "proposalId",
    "sourceSignals",
    "status",
    "summary",
    "recommendedAction",
    "projectDecisionChange",
    "approvedBy",
    "approvedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^IMP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "sourceSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "converted"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommendedAction": {
      "enum": [
        "create-task",
        "change-project-decision",
        "monitor",
        "reject"
      ]
    },
    "projectDecisionChange": {
      "type": "boolean"
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
