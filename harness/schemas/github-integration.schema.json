{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/github-integration.schema.json",
  "type": "object",
  "required": ["schemaVersion", "standard", "writePolicy", "productionEnvironment"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.1.0" },
    "standard": {
      "type": "object",
      "required": ["provider", "authentication", "requiredRemoteProtocol", "includeUntrustedTextByDefault", "recentRunLimit", "commandTimeoutMs", "reportPathTemplate"],
      "properties": {
        "provider": { "const": "gh-cli-https" },
        "authentication": { "const": "gh-auth-login-and-setup-git" },
        "requiredRemoteProtocol": { "const": "https" },
        "includeUntrustedTextByDefault": { "type": "boolean" },
        "recentRunLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "commandTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "reportPathTemplate": { "type": "string", "pattern": "\\{task\\}" }
      },
      "additionalProperties": false
    },
    "writePolicy": {
      "type": "object",
      "required": ["enabled", "actor", "requiresHumanApproval", "protectedBranches", "allowForcePush", "allowMerge", "allowSecretMutation", "requireCleanWorktree", "requireVerificationPass", "requireReviewPass", "proposalSchema"],
      "properties": {
        "enabled": { "const": true },
        "actor": { "const": "packager" },
        "requiresHumanApproval": { "const": true },
        "protectedBranches": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "allowForcePush": { "const": false },
        "allowMerge": { "const": false },
        "allowSecretMutation": { "const": false },
        "requireCleanWorktree": { "const": true },
        "requireVerificationPass": { "const": true },
        "requireReviewPass": { "const": true },
        "proposalSchema": { "type": "string" }
      },
      "additionalProperties": false
    },
    "productionEnvironment": {
      "type": "object",
      "required": ["name", "workflow", "requiredReviewers", "deploymentBranchPolicy", "requiredProtectedBranches", "allowAdminBypass", "providerDeploymentIncluded"],
      "properties": {
        "name": { "const": "production" },
        "workflow": { "const": ".github/workflows/release-gate.yml" },
        "requiredReviewers": {
          "type": "object",
          "required": ["minimum", "preventSelfReview"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 1, "maximum": 6 },
            "preventSelfReview": { "const": true }
          },
          "additionalProperties": false
        },
        "deploymentBranchPolicy": { "const": "protected-branches-only" },
        "requiredProtectedBranches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowAdminBypass": { "const": false },
        "providerDeploymentIncluded": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
