{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/profile-resolution.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "requestedProfiles",
        "resolvedProfiles",
        "commands",
        "checks"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "status": {
          "const": "unresolved"
        },
        "requestedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resolvedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "requestedProfiles",
        "resolvedProfiles",
        "commands",
        "checks",
        "capabilities",
        "riskControls",
        "registrySha256",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "status": {
          "const": "resolved"
        },
        "requestedProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resolvedProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "riskControls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "registrySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  ]
}
