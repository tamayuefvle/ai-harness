{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/fallback-handoff.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "handoffId",
    "taskId",
    "acceptanceId",
    "sourceExecutor",
    "targetExecutor",
    "failedGoal",
    "strategyId",
    "strategySummary",
    "failureClass",
    "failureSignature",
    "commandsExecuted",
    "changedArtifactRefs",
    "evidenceRefs",
    "cursorDiagnosis",
    "prohibitedRepeats",
    "approvedDesignDigest",
    "head",
    "workspaceDigest",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^FBH-[A-Za-z0-9._-]+$"
    },
    "taskId": {
      "type": "string"
    },
    "acceptanceId": {
      "type": "string",
      "pattern": "^AC-[0-9]{3,}$"
    },
    "sourceExecutor": {
      "const": "cursor"
    },
    "targetExecutor": {
      "const": "codex-cli"
    },
    "failedGoal": {
      "type": "string",
      "minLength": 1
    },
    "strategyId": {
      "type": "string",
      "minLength": 1
    },
    "strategySummary": {
      "type": "string",
      "minLength": 1
    },
    "failureClass": {
      "type": "string",
      "minLength": 1
    },
    "failureSignature": {
      "type": "string",
      "minLength": 1
    },
    "commandsExecuted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changedArtifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cursorDiagnosis": {
      "type": "string",
      "minLength": 1
    },
    "prohibitedRepeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvedDesignDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
