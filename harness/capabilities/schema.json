{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/capability-manifest.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "risk",
          "providers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "local-read",
              "local-write",
              "external-read",
              "external-write",
              "production"
            ]
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "priority",
                "required",
                "operations"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1
                },
                "required": {
                  "type": "boolean"
                },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "approval": {
                  "enum": [
                    "none",
                    "per-operation",
                    "human-only"
                  ]
                },
                "enabledByDefault": {
                  "type": "boolean"
                },
                "confidenceScore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "stopWhenSufficient": {
                  "type": "boolean"
                },
                "trigger": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "resolutionStrategy": {
            "type": "object",
            "required": [
              "classification",
              "stopWhenSufficient",
              "evidenceOrder",
              "materialDecisionRequiresPrimarySource",
              "context7Trigger",
              "requiredEvidenceFields"
            ],
            "properties": {
              "classification": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "stopWhenSufficient": {
                "type": "boolean"
              },
              "evidenceOrder": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "materialDecisionRequiresPrimarySource": {
                "type": "boolean"
              },
              "context7Trigger": {
                "type": "object",
                "required": [
                  "mode",
                  "conditions",
                  "default",
                  "onUnavailable"
                ],
                "properties": {
                  "mode": {
                    "const": "all"
                  },
                  "conditions": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "default": {
                    "const": "disabled"
                  },
                  "onUnavailable": {
                    "const": "degrade-without-blocking"
                  }
                },
                "additionalProperties": false
              },
              "requiredEvidenceFields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
