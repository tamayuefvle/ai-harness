{
  "schemaVersion": "1.0.0",
  "id": "language/typescript",
  "version": "1.0.0",
  "kind": "language",
  "status": "stable",
  "requires": [
    "runtime/node"
  ],
  "conflicts": [],
  "rules": [],
  "commands": {
    "typecheck": "npm run typecheck",
    "lint": "npm run lint"
