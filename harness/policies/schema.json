{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/command-guardrails.schema.json",
  "type": "object",
  "required": ["$schema","schemaVersion","owner","deniedExecutables","commandPatterns","inlineInterpreterExecutables","secretArgumentPatterns","generatedInstructionMarkers","cursorPermissions","codexPrefixRules"],
  "properties": {
    "$schema": {"type":"string"},
    "schemaVersion": {"const":"1.0.0"},
    "owner": {"const":"execution-safety-kernel"},
    "deniedExecutables": {"type":"array","minItems":1,"items":{"type":"object","required":["id","name"],"properties":{"id":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"name":{"type":"string","minLength":1}},"additionalProperties":false}},
    "commandPatterns": {"type":"array","minItems":1,"items":{"type":"object","required":["id","regex","flags","message","surfaces"],"properties":{"id":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"regex":{"type":"string","minLength":1},"flags":{"type":"string","pattern":"^[gimsuy]*$"},"message":{"type":"string","minLength":1},"surfaces":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["runtime","security","codex-hook","cursor-hook"]}}},"additionalProperties":false}},
    "inlineInterpreterExecutables": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "secretArgumentPatterns": {"type":"array","minItems":1,"items":{"type":"object","required":["id","regex","flags"],"properties":{"id":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"regex":{"type":"string","minLength":1},"flags":{"type":"string","pattern":"^[gimsuy]*$"}},"additionalProperties":false}},
    "generatedInstructionMarkers": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "cursorPermissions": {"type":"object","required":["baseDeny","readOnlyExtraDeny","implementerExtraDeny"],"properties":{"baseDeny":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"readOnlyExtraDeny":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"implementerExtraDeny":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
    "codexPrefixRules": {"type":"array","minItems":1,"items":{"type":"object","required":["id","pattern","decision","justification","match"],"properties":{"id":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"pattern":{"type":"array","minItems":1},"decision":{"enum":["forbidden","prompt"]},"justification":{"type":"string","minLength":1},"match":{"type":"array","minItems":1,"items":{"type":"string"}}},"additionalProperties":false}}
  },
  "additionalProperties": false
}
