{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-harness.local/schemas/invariant-manifest.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "governance",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "governance": {
      "type": "object",
      "required": [
        "canonical",
        "changeApproval",
        "generatedProjection"
      ],
      "properties": {
        "canonical": {
          "const": true
        },
        "changeApproval": {
          "const": "human"
        },
        "generatedProjection": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "statement",
          "nonOverridable",
          "verification",
          "violationAction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-[A-Z0-9-]+$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "nonOverridable": {
            "type": "boolean"
          },
          "verification": {
            "type": "object",
            "required": [
              "method",
              "timings"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "timings": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "violationAction": {
            "enum": [
              "block-operation",
              "stop-run",
              "quarantine-run",
              "return-to-verification"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
