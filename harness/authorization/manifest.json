{
  "$schema": "./schema.json",
  "schemaVersion": "1.0.0",
  "defaultEffect": "deny",
  "capabilityManifest": "harness/capabilities/manifest.json",
  "roles": [
    "orchestrator",
    "researcher",
    "planner",
    "architect",
    "implementer",
    "verifier",
    "reviewer",
    "system-adapter",
    "packager"
  ],
  "conditionDefinitions": {
    "work-scope-match": {
      "evidenceSource": "current canonical lifecycle binding and approved run/spec scope",
      "selfAssertable": false
    },
    "approved-path-match": {
      "evidenceSource": "approved design/foundation path contract plus repository command policy",
      "selfAssertable": false
    },
    "operation-approval-required": {
      "evidenceSource": "operation-approval artifact bound to the pending run operation",
      "selfAssertable": false
    },
    "approved-digest-match": {
      "evidenceSource": "operation-approval argumentDigest equals pending operation argumentDigest",
      "selfAssertable": false
    },
    "idempotency-key-required": {
      "evidenceSource": "persisted pending operation idempotencyKey",
      "selfAssertable": false
    },
    "read-only": {
      "evidenceSource": "provider adapter operation semantics and command policy",
      "selfAssertable": false
    },
    "evidence-append-only": {
      "evidenceSource": "evidence adapter append-only enforcement",
      "selfAssertable": false
    },
    "provider-enabled": {
      "evidenceSource": "capability manifest plus effective provider/MCP runtime configuration",
      "selfAssertable": false
    }
  },
